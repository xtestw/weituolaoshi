page {
  --color-primary: #5b67f1;
  --color-primary-ink: #3943a9;
  --color-primary-soft: #eff0ff;
  --color-cta: #cf367a;
  --color-cta-ink: #b53170;
  --color-cta-soft: #fff0f7;
  --color-bg: #f7f7fb;
  --color-surface: #ffffff;
  --color-soft: #f3f1ff;
  --color-text: #241d2d;
  --color-muted: #625b6b;
  --color-muted-soft: #756e7a;
  --color-border: #e7e2ec;
  --color-success: #16845b;
  --color-success-soft: #e9f7f1;
  --color-danger: #c9384f;
  --color-danger-soft: #fff0f2;
  --shadow-card: 0 10rpx 28rpx rgba(67, 55, 91, .07);
  --shadow-float: 0 18rpx 44rpx rgba(67, 55, 91, .12);
  --type-page: 38rpx;
  --type-section: 34rpx;
  --type-card: 30rpx;
  --type-body: 28rpx;
  --type-meta: 25rpx;
  --type-caption: 23rpx;
  --weight-page: 800;
  --weight-section: 750;
  --weight-card: 700;
  min-height: 100%;
  background: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans SC", sans-serif;
  font-size: var(--type-body);
  line-height: 1.5;
}

button, input, textarea, picker { font: inherit; }
button::after { border: 0; }
button { box-sizing: border-box; transition: opacity .18s ease, background-color .18s ease, border-color .18s ease; }
button:active { opacity: .78; }
.page { min-height: 100vh; box-sizing: border-box; padding: 24rpx 28rpx calc(180rpx + env(safe-area-inset-bottom)); }
.page--no-tab { padding-bottom: calc(176rpx + env(safe-area-inset-bottom)); }
.safe-top { padding-top: calc(env(safe-area-inset-top) + 88rpx); }
.topbar { min-height: 96rpx; display: flex; align-items: center; gap: 16rpx; padding: 0 28rpx; background: rgba(255,255,255,.96); border-bottom: 1rpx solid var(--color-border); }
.topbar__title { flex: 1; min-width: 0; font-size: var(--type-page); line-height: 1.25; font-weight: var(--weight-page); }
.topbar__action { min-width: 88rpx; min-height: 88rpx; margin: 0; padding: 0 12rpx; border: 0; background: transparent; color: var(--color-primary); font-size: 28rpx; font-weight: 650; display: flex; align-items: center; justify-content: center; }
.topbar__badge { width: 12rpx; height: 12rpx; margin: -30rpx 0 0 -12rpx; border-radius: 50%; background: var(--color-cta); }
.section { margin-top: 24rpx; padding: 28rpx; border: 1rpx solid rgba(231,226,236,.9); border-radius: 32rpx; background: var(--color-surface); box-shadow: var(--shadow-card); }
.section__head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 20rpx; }
.section__title { font-size: var(--type-section); line-height: 1.3; font-weight: var(--weight-section); color: var(--color-text); }
.section__link { color: var(--color-primary-ink); font-size: var(--type-meta); font-weight: 700; }
.muted { color: var(--color-muted); font-size: var(--type-meta); line-height: 1.45; }
.caption { color: var(--color-muted); font-size: var(--type-caption); line-height: 1.45; }
.price { color: var(--color-cta); font-weight: 800; font-variant-numeric: tabular-nums; }
.price__unit { font-size: 22rpx; font-weight: 550; }
.btn { min-height: 88rpx; box-sizing: border-box; padding: 18rpx 28rpx; border: 1rpx solid var(--color-border); border-radius: 999rpx; background: var(--color-surface); color: var(--color-text); font-size: 28rpx; font-weight: 680; display: flex; align-items: center; justify-content: center; }
.btn[disabled] { opacity: 1; border-color: #dedbe5; background: #f3f1f6; color: #756e7a; }
.btn--primary { border-color: var(--color-primary); background: var(--color-primary); color: #fff; }
.btn--cta { border-color: var(--color-cta); background: var(--color-cta); color: #fff; }
.btn--danger { border-color: var(--color-danger); color: var(--color-danger); }
.btn--small { min-height: 72rpx; padding: 10rpx 24rpx; font-size: 26rpx; }
.btn-row { display: flex; gap: 16rpx; }
.btn-row .btn { flex: 1; }
.chip-row { display: flex; gap: 14rpx; overflow-x: auto; white-space: nowrap; padding: 4rpx 0; }
.chip { min-height: 72rpx; box-sizing: border-box; padding: 12rpx 26rpx; border: 1rpx solid var(--color-border); border-radius: 999rpx; background: var(--color-surface); color: var(--color-muted); font-size: 26rpx; display: inline-flex; align-items: center; justify-content: center; }
.chip--active { border-color: var(--color-primary); background: var(--color-primary-soft); color: var(--color-primary-ink); font-weight: 700; }
.tag { display: inline-flex; align-items: center; min-height: 48rpx; padding: 0 16rpx; border-radius: 999rpx; background: var(--color-soft); color: var(--color-primary); font-size: 24rpx; }
.tag--success { background: var(--color-success-soft); color: var(--color-success); }
.field { width: 100%; min-height: 88rpx; box-sizing: border-box; margin-top: 14rpx; padding: 20rpx 24rpx; border: 1rpx solid var(--color-border); border-radius: 20rpx; background: #fff; color: var(--color-text); font-size: 30rpx; }
textarea.field { min-height: 180rpx; }
.field-label { display: block; margin-top: 24rpx; font-size: 27rpx; font-weight: 680; }
.field-help { display: block; margin-top: 8rpx; color: var(--color-muted); font-size: 24rpx; }
.field-error { display: block; margin-top: 8rpx; color: var(--color-danger); font-size: 24rpx; }
.line { min-height: 96rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; border-bottom: 1rpx solid var(--color-border); }
.line:last-child { border-bottom: 0; }
.line__main { flex: 1; min-width: 0; }
.line__title { display: block; font-size: var(--type-body); font-weight: 650; }
.line__value { color: var(--color-muted); text-align: right; }
.control-chevron { width: 15rpx; height: 15rpx; box-sizing: border-box; display: inline-block; flex: none; border-right: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; color: var(--color-muted); transform: rotate(-45deg); transition: transform .18s ease, color .18s ease; }
.control-chevron--down { transform: rotate(45deg) translateY(-3rpx); }
.control-chevron--up { transform: rotate(225deg) translateY(-3rpx); }
.control-chevron--active { color: var(--color-primary-ink); }
.notice { margin-top: 20rpx; padding: 20rpx 24rpx; border-radius: 20rpx; background: var(--color-primary-soft); color: #3943a9; font-size: 25rpx; }
.notice--danger { background: var(--color-danger-soft); color: var(--color-danger); }
.empty { padding: 80rpx 28rpx; text-align: center; color: var(--color-muted); }
.bottom-actions { position: fixed; z-index: 40; left: 0; right: 0; bottom: 0; box-sizing: border-box; display: flex; align-items: center; gap: 16rpx; padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--color-border); background: rgba(255,255,255,.98); box-shadow: 0 -10rpx 28rpx rgba(55,42,77,.06); }
.bottom-actions .btn { flex: 1; min-width: 0; margin: 0; white-space: nowrap; }
.bottom-actions .btn:last-child { flex: 1.45; }
.skeleton { border-radius: 16rpx; background: linear-gradient(90deg,#f1eef5,#faf9fc,#f1eef5); background-size: 200% 100%; }

@media (prefers-reduced-motion: no-preference) {
  .skeleton { animation: shimmer 1.4s infinite linear; }
  @keyframes shimmer { to { background-position: -200% 0; } }
}
