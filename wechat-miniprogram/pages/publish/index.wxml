<view class="safe-top publish-head"><view class="publish-head__bar"><text>Coser发布</text></view></view>
<view class="page publish-page">
  <view wx:if="{{verified}}" class="publish-summary"><view><text>创作中心</text><text>已认证 · 可发布多个服务帖子</text></view><button bindtap="viewHomepage">预览主页</button></view>

  <button wx:if="{{verified}}" class="coser-city" bindtap="refreshCity"><text>服务城市</text><text>{{coserCity ? coserCity + ' · 重新定位' : '定位我的城市'}} ›</text></button>

  <view class="primary-actions"><button class="new-post" bindtap="newPost"><view class="plus"></view><view><text>发布新帖</text><text>{{verified ? '发布新的角色服务' : (reviewStatus === 'pending' ? '真人认证审核中，结果将通过消息通知' : (reviewStatus === 'rejected' ? '认证未通过：' + reviewReason : '先完成真人认证'))}}</text></view><text>›</text></button></view>

  <block wx:if="{{verified}}">
    <view class="section posts"><view class="section__head"><text class="section__title">我的帖子 · {{posts.length}}</text></view>
      <view wx:if="{{!posts.length}}" class="empty"><text>还没有帖子，发布第一篇角色服务吧</text></view>
      <view wx:for="{{posts}}" wx:key="id" class="post"><view class="post__cover">{{item.coverMark || 'COS'}}</view><view class="post__copy"><text>{{item.title}}</text><text>¥{{item.price}}/小时 · 最低{{item.minHours}}小时</text><text class="{{item.locked ? 'locked' : ''}}">{{item.locked ? '进行中 · 已锁定' : item.statusText}}</text></view><view class="post__tools"><button data-index="{{index}}" bindtap="edit">编辑</button><button data-index="{{index}}" bindtap="remove">删除</button></view></view>
    </view>
  </block>
</view>
