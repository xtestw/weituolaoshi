<view class="chat-page">
  <view class="safety">请勿在站外支付；涉及改期或边界调整请在订单内留痕。</view>
  <scroll-view class="chat-list" scroll-y scroll-into-view="bottom">
    <button wx:if="{{hasMore}}" bindtap="loadOlder">加载更早消息</button>
    <view wx:for="{{messages}}" wx:key="id" class="bubble-row bubble-row--{{item.from}}" data-index="{{index}}" bindtap="viewImage" bindlongpress="report"><view class="bubble">{{item.text}}</view></view>
    <view id="bottom"></view>
  </scroll-view>
  <view wx:if="{{isCoser}}" class="confirm-card"><view><text>确认预约时间</text><input placeholder="开始：2026-11-21 14:00" bindinput="onStart" /><input placeholder="结束：2026-11-21 17:00" bindinput="onEnd" /></view><button bindtap="confirmTime">确认</button></view>
  <view class="composer"><button bindtap="chooseImage">图片</button><input value="{{text}}" bindinput="onText" bindconfirm="send" confirm-type="send" placeholder="仅用于订单咨询与履约沟通" /><button bindtap="send">发送</button></view>
</view>
