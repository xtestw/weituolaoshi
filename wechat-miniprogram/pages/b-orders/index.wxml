<view class="order-toolbar"><scroll-view class="filters" scroll-x show-scrollbar="false"><button wx:for="{{filters}}" wx:key="key" class="{{filter === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="select">{{item.label}}</button></scroll-view></view>
<view class="page orders-page">
  <view wx:for="{{visibleOrders}}" wx:key="id" class="section order">
    <view class="section__head"><text class="section__title">{{item.title}}</text><text class="tag">{{item.statusText}}</text></view>
    <text class="muted">{{item.customer}} · {{item.date}} · ¥{{item.amount}}</text>
    <text class="muted">{{item.place}}</text>
    <view class="btn-row">
      <button class="btn btn--small" data-id="{{item.id}}" bindtap="contact">私信</button>
      <button wx:if="{{item.status === 'paid_pending_confirm'}}" class="btn btn--danger btn--small" data-id="{{item.id}}" bindtap="reject">无法接单</button>
      <button wx:if="{{item.status === 'paid_pending_confirm'}}" class="btn btn--primary btn--small" data-id="{{item.id}}" bindtap="accept">确认接单</button>
      <button wx:if="{{item.status === 'service'}}" class="btn btn--primary btn--small" data-id="{{item.id}}" bindtap="checkIn">现场签到</button>
      <button wx:if="{{item.status === 'in_service'}}" class="btn btn--primary btn--small" data-id="{{item.id}}" bindtap="complete">确认完成</button>
      <button wx:if="{{item.status === 'service' || item.status === 'in_service'}}" class="btn btn--danger btn--small" data-id="{{item.id}}" bindtap="openException">异常</button>
    </view>
  </view>
  <view wx:if="{{!visibleOrders.length}}" class="empty">当前状态下没有委托订单</view>
</view>
<button class="emergency-float" bindtap="callEmergencyContact">紧急联系</button>
<view wx:if="{{checkInOpen}}" class="checkin-mask" bindtap="closeCheckIn"><view class="checkin-sheet" catchtap="stopTap"><view class="section__head"><text class="section__title">现场签到</text><button bindtap="closeCheckIn">×</button></view><text class="muted">向用户索取4位履约码，定位并拍摄现场照片。</text><input class="checkin-input" type="number" maxlength="4" value="{{checkInInput}}" bindinput="onCheckInCode" placeholder="4位履约码"/><button class="btn" bindtap="captureLocation">{{checkInLocation ? '已获取位置' : '获取当前位置'}}</button><button class="btn" bindtap="chooseCheckInPhoto">{{checkInPhoto ? '已拍摄照片' : '拍摄现场照片'}}</button><image wx:if="{{checkInPhoto}}" class="checkin-preview" src="{{checkInPhoto}}" mode="aspectFill"/><button class="btn btn--primary" bindtap="submitCheckIn" loading="{{checkInBusy}}" disabled="{{checkInBusy}}">确认开始履约</button></view></view>
