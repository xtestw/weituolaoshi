<view class="order-toolbar"><scroll-view class="filters" scroll-x show-scrollbar="false"><button wx:for="{{filters}}" wx:key="key" class="{{filter === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="select">{{item.label}}</button></scroll-view><button class="exception-button" bindtap="openException">异常</button></view>
<view class="page orders-page">
  <view wx:if="{{filter === 'all' || filter === (accepted ? 'service' : 'pending')}}" class="section order"><view class="section__head"><text class="section__title">三月七｜漫展同行</text><text class="tag {{accepted ? 'tag--success' : ''}}">{{accepted ? '待履约' : '已付款待确认'}}</text></view><text class="muted">小鱼 · 11月16日 14:00–17:00 · ¥564</text><text class="muted">需求：逛展同行、合影互动，公共场所见面</text><view class="btn-row"><button class="btn btn--small" bindtap="contact">私信</button><button wx:if="{{!accepted}}" class="btn btn--danger btn--small" bindtap="reject">无法接单</button><button wx:if="{{!accepted}}" class="btn btn--primary btn--small" bindtap="accept">确认接单</button><button wx:if="{{accepted}}" class="btn btn--primary btn--small" bindtap="checkIn">输入履约码</button></view></view>
  <view wx:if="{{filter === 'all' || filter === 'service'}}" class="section order"><view class="section__head"><text class="section__title">芙宁娜｜主题摄影</text><text class="tag tag--success">待履约</text></view><text class="muted">林林 · 11月21日 10:00–12:00 · ¥416</text><view class="btn-row"><button class="btn btn--small" bindtap="contactSecond">联系用户</button><button class="btn btn--primary btn--small" bindtap="checkIn">输入履约码</button></view></view>
  <view wx:if="{{filter === 'all' || filter === 'done'}}" class="section order"><view class="section__head"><text class="section__title">流萤｜生日互动</text><text class="tag tag--success">已完成</text></view><text class="muted">晚星 · 10月28日 18:00–21:00</text><text class="muted">已结算 ¥701 · 平台技术服务费已扣除</text></view>
</view>
