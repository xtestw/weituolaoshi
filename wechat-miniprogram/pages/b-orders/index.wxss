.order-toolbar { display: flex; align-items: center; border-bottom: 1rpx solid var(--color-border); background: #fff; }
.filters { flex: 1; min-width: 0; box-sizing: border-box; padding: 10rpx 16rpx 10rpx 28rpx; white-space: nowrap; background: #fff; }
.filters button { min-height: 76rpx; margin-right: 10rpx; padding: 0 22rpx; display: inline-flex; align-items: center; justify-content: center; vertical-align: top; border: 0; border-radius: 999rpx; background: transparent; color: var(--color-muted); font-size: 25rpx; line-height: 1; }
.filters .active { background: var(--color-primary-soft); color: var(--color-primary-ink); font-weight: 750; }
.exception-button { min-width: 96rpx; min-height: 88rpx; margin: 0 20rpx 0 0; padding: 0 16rpx; border: 1rpx solid #f1c7cf; border-radius: 999rpx; background: var(--color-danger-soft); color: var(--color-danger); font-size: 23rpx; }
.orders-page { padding-top: 4rpx; padding-bottom: 48rpx; }
.order>.muted { margin: 7rpx 0; display: block; }
.order .btn-row { margin-top: 22rpx; }
.order .btn-row { flex-wrap: wrap; }
.order .btn-row .btn { flex: 1 1 28%; min-width: 0; padding-left: 8rpx; padding-right: 8rpx; font-size: 24rpx; }
