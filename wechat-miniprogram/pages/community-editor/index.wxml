<view class="page"><view class="heading">{{id ? '编辑社区帖子' : '发布社区帖子'}}</view><input class="field" value="{{title}}" maxlength="200" placeholder="标题" bindinput="onTitle"/><textarea class="body" value="{{body}}" maxlength="5000" placeholder="分享你的想法、体验或问题" bindinput="onBody"/><view class="actions"><button bindtap="draft" disabled="{{saving}}">保存草稿</button><button class="primary" bindtap="publish" disabled="{{saving}}">发布</button></view></view>
