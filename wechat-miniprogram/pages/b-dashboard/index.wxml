<view class="page dashboard-page">
  <view class="dashboard-tools"><button bindtap="switchCustomer">切换到用户端</button><button bindtap="openMessages">消息 <text>2</text></button></view>
  <view class="dashboard-hero"><view><text class="dashboard-hero__eyebrow">晚上好，阿梨</text><text class="dashboard-hero__title">{{accepted ? '今天有2场待履约' : '有1笔新委托待确认'}}</text><text>真人认证已通过 · 营业中</text></view><view class="score"><text>{{averageScore}}</text><text>交易评分</text></view></view>
  <view class="metric-grid"><view><text>{{averageScore}}</text><text>累计{{scoredOrders}}笔评分</text></view><view><text>{{coserIncompleteCount}}</text><text>审核确认未履约</text></view><view><text>2</text><text>本周履约</text></view></view>
  <view class="section"><text class="muted">仅统计平台审核确认属于Coser责任的未完成履约订单；审核中与无责订单不计入。</text></view>
  <view class="section"><view class="section__head"><text class="section__title">快捷管理</text></view><view class="quick-grid"><button bindtap="openOrders"><view class="quick-mark">单</view><text>订单</text></button><button bindtap="openCalendar"><view class="quick-mark">历</view><text>档期</text></button><button bindtap="openPublish"><view class="quick-mark">帖</view><text>帖子</text></button><button bindtap="openProfile"><view class="quick-mark">账</view><text>收益</text></button></view></view>
  <view class="section new-order"><view class="section__head"><text class="section__title">{{accepted ? '即将履约' : '新委托待确认'}}</text><button class="section__link" bindtap="openOrders">全部订单 ›</button></view><text class="new-order__title">三月七｜漫展同行 <text class="tag {{accepted ? 'tag--success' : ''}}">{{accepted ? '已确认' : '已付款'}}</text></text><text class="muted">小鱼 · 11月16日 14:00–17:00</text><text class="muted">国家会展中心 2号门 · 实付 ¥564</text><view class="request">需求：逛展同行、合影互动；不接受肢体接触，全程不饮酒。</view><view class="btn-row"><button class="btn btn--small" bindtap="contact">私信沟通</button><button wx:if="{{!accepted}}" class="btn btn--danger btn--small" bindtap="reject">无法接单</button><button wx:if="{{!accepted}}" class="btn btn--primary btn--small" bindtap="accept">确认接单</button><button wx:else class="btn btn--primary btn--small" bindtap="openOrders">查看订单</button></view></view>
  <view class="section risk"><view class="section__head"><text class="section__title">履约安全</text><text class="section__link">查看规则</text></view><view class="line"><text>仅限公共场所</text><text class="tag tag--success">已校验</text></view><view class="line"><text>异常与申诉</text><text class="line__value">随时上报 ›</text></view></view>
  <button class="standalone-entry" bindtap="openException"><view class="quick-mark quick-mark--danger">盾</view><view><text>履约异常处理</text><text>用户未到、地点风险、取消责任与争议申诉</text></view><text>›</text></button>
</view>
<button wx:if="{{accepted}}" class="emergency-float" bindtap="callEmergencyContact" aria-label="紧急联系预设联系人">紧急联系</button>
<b-tabbar selected="dashboard" />
