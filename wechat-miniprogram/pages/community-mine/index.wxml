<view class="page"><button class="primary" bindtap="create">发布社区帖子</button><view wx:for="{{posts}}" wx:key="id" class="item"><text class="title" data-index="{{index}}" bindtap="open">{{item.title}}</text><text>{{item.status === 'draft' ? '草稿' : '已发布'}}</text><view class="actions"><button data-index="{{index}}" bindtap="edit">编辑</button><button data-index="{{index}}" bindtap="remove">删除</button></view></view><view wx:if="{{!posts.length}}">还没有社区帖子</view></view>
