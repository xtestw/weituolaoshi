<view class="status-hero status-hero--{{order.status}}"><text class="status-hero__title">{{order.statusText}}</text><text wx:if="{{order.status === 'unpaid'}}">完成成年与同性身份校验后付款</text><text wx:elif="{{order.status === 'paid_pending_confirm'}}">Coser将在24小时内确认，超时自动退款</text><text wx:elif="{{order.status === 'cancel_pending'}}">平台已通知对方处理取消责任</text><text wx:else>请按订单约定完成后续操作</text></view>
<view class="page detail-page">
  <view wx:if="{{order.status === 'unpaid' && showIdentityCard}}" class="section identity-card {{identityPassed ? 'identity-card--passed' : ''}}">
    <view class="section__head"><text class="section__title">首次付款前身份校验</text><text class="tag {{identityPassed ? 'tag--success' : ''}}">{{identityPassed ? '已通过' : '待完成'}}</text></view>
    <text class="muted">仅用于校验年满18周岁和同性下单。页面不会向Coser或其他用户展示任何证件信息。</text>
    <view wx:if="{{identityPassed}}" class="identity-result"><view>✓</view><text>{{identityText}}</text></view>
    <button wx:else class="btn btn--primary identity-action" bindtap="verifyIdentity">去实名认证</button>
  </view>
  <view class="section"><view class="service"><view class="cover">MAR</view><view><text class="section__title">{{order.title}}</text><text class="muted">Coser：{{order.coser}}</text><text class="price">¥{{order.amount}}</text></view></view></view>
  <view class="section"><view class="line"><text>时间</text><text class="line__value">{{order.date}}</text></view><view class="line"><text>地点</text><text class="line__value">{{order.place}}</text></view><view class="line"><text>相处边界</text><text class="line__value">{{boundaryText}}</text></view><view class="line"><text>服务金额</text><text class="line__value">¥{{order.amount}}</text></view><view class="line"><text>用户侧平台服务费</text><text class="line__value">¥0</text></view><view class="line"><text>订单编号</text><text class="line__value">{{order.id}}</text></view></view>
  <view class="section progress"><view class="section__head"><text class="section__title">委托进度</text></view><view class="step {{order.status !== 'unpaid' ? 'step--done' : ''}}"><view></view><text>用户付款</text><text>{{order.status === 'unpaid' ? '待完成' : '平台担保中'}}</text></view><view class="step {{order.status === 'service' || order.status === 'completed' ? 'step--done' : ''}}"><view></view><text>Coser确认</text><text>最长24小时</text></view><view class="step {{order.status === 'completed' ? 'step--done' : ''}}"><view></view><text>线下履约</text><text>仅限公共场所</text></view><view class="step {{order.status === 'completed' ? 'step--done' : ''}}"><view></view><text>双方确认并结算</text><text>完成后打款</text></view></view>
  <view class="section"><view class="section__head"><text class="section__title">取消与异常</text></view><text class="muted">履约前48小时外可无责取消；48小时内需填写原因并由双方确认责任。发生安全问题请立即终止履约并联系平台。</text><button wx:if="{{order.status !== 'completed'}}" class="btn btn--danger cancel" bindtap="cancel">申请取消订单</button></view>
  <view class="section safety-card"><view class="section__head"><text class="section__title">安全保障</text><text class="tag tag--success">平台担保</text></view><view class="line"><text>服务场所</text><text class="line__value">仅限公共场所</text></view><view class="line"><text>履约验证</text><text class="line__value">双方签到 · 动态履约码</text></view><view class="line"><text>资金结算</text><text class="line__value">双方确认完成后打款</text></view></view>
</view>
<view class="bottom-actions"><button class="btn" bindtap="contact">联系Coser</button><button wx:if="{{order.status === 'unpaid'}}" class="btn btn--cta" bindtap="pay" disabled="{{!identityPassed}}">{{identityPassed ? '立即支付 ¥' + order.amount : '实名后付款'}}</button><button wx:elif="{{order.status === 'service'}}" class="btn btn--cta" bindtap="complete">确认完成</button><button wx:else class="btn btn--primary" disabled>平台担保中</button></view>
