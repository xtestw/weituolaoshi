<view class="status-hero status-hero--{{order.status}}"><text class="status-hero__title">{{order.statusText}}</text><text wx:if="{{order.status === 'unpaid'}}">完成成年与女性身份校验后付款</text><text wx:elif="{{order.status === 'paid_pending_confirm'}}">Coser将在24小时内确认，超时自动退款</text><text wx:elif="{{order.status === 'cancel_pending'}}">平台已通知对方处理取消责任</text><text wx:else>请按订单约定完成后续操作</text></view>
<view class="page detail-page">
  <view wx:if="{{order.status === 'unpaid' && showIdentityCard}}" class="section identity-card {{identityPassed ? 'identity-card--passed' : ''}}">
    <view class="section__head"><text class="section__title">首次付款前身份校验</text><text class="tag {{identityPassed ? 'tag--success' : ''}}">{{identityPassed ? '已通过' : '待完成'}}</text></view>
    <text class="muted">仅用于校验年满18周岁和女性身份。页面不会向Coser或其他用户展示任何证件信息。</text>
    <view wx:if="{{identityPassed}}" class="identity-result"><view>✓</view><text>{{identityText}}</text></view>
    <button wx:elif="{{!verifiedIdentity}}" class="btn btn--primary identity-action" bindtap="verifyIdentity">去实名认证</button><text wx:else class="field-error">身份已核验，当前不符合下单条件；仍可浏览内容。</text>
  </view>
  <view class="section"><view class="service"><view class="cover">MAR</view><view><text class="section__title">{{order.title}}</text><text class="muted">Coser：{{order.coser}}</text><text class="price">¥{{order.amount}}</text></view></view></view>
  <view class="section"><view class="line"><text>时间</text><text class="line__value">{{order.date}}</text></view><view class="line"><text>地点</text><text class="line__value">{{order.place}}</text></view><view class="line"><text>相处边界</text><text class="line__value">{{boundaryText}}</text></view><view class="line"><text>服务金额</text><text class="line__value">¥{{order.amount}}</text></view><view class="line"><text>用户侧平台服务费</text><text class="line__value">¥0</text></view><view class="line"><text>订单编号</text><text class="line__value">{{order.id}}</text></view></view>
  <view wx:if="{{order.status === 'service' || order.status === 'in_service'}}" class="section"><view class="section__head"><text class="section__title">履约签到</text><text class="tag {{order.status === 'in_service' ? 'tag--success' : ''}}">{{order.status === 'in_service' ? '已开始' : '待现场确认'}}</text></view><text class="muted">订单确认后自动生成4位码。现场告知Coser，由Coser填码、获取位置并上传现场照片，三项通过后开始履约。</text><text wx:if="{{checkInCode && order.status === 'service'}}" class="checkin-code">{{checkInCode}}</text><text wx:if="{{checkInCode && order.status === 'service'}}" class="caption">本次签到码固定不变，签到后即失效。请仅在现场告知Coser。</text></view>
  <view wx:if="{{order.status === 'completed'}}" class="section"><view class="section__head"><text class="section__title">给Coser评分</text></view><button class="btn btn--primary" bindtap="rateOrder" disabled="{{reviewed}}">{{reviewed ? '已评分' : '为本次委托打分'}}</button></view>
  <view class="section progress"><view class="section__head"><text class="section__title">委托进度</text></view><view class="step {{order.status !== 'unpaid' ? 'step--done' : ''}}"><view></view><text>用户付款</text><text>{{order.status === 'unpaid' ? '待完成' : '平台担保中'}}</text></view><view class="step {{order.status === 'service' || order.status === 'in_service' || order.status === 'completed' ? 'step--done' : ''}}"><view></view><text>Coser确认</text><text>最长24小时</text></view><view class="step {{order.status === 'in_service' || order.status === 'completed' ? 'step--done' : ''}}"><view></view><text>现场签到</text><text>C端出码 · B端取证</text></view><view class="step {{order.status === 'completed' ? 'step--done' : ''}}"><view></view><text>双方确认并结算</text><text>完成后打款</text></view></view>
  <view class="section"><view class="section__head"><text class="section__title">取消与异常</text></view><text class="muted">履约前48小时外可无责取消；48小时内需填写原因并由双方确认责任。发生安全问题请立即终止履约并联系平台。</text><button wx:if="{{order.status !== 'completed'}}" class="btn btn--danger cancel" bindtap="cancel">申请取消订单</button></view>
  <view class="section safety-card"><view class="section__head"><text class="section__title">安全保障</text><text class="tag tag--success">平台担保</text></view><view class="line"><text>服务场所</text><text class="line__value">仅限公共场所</text></view><view class="line"><text>履约验证</text><text class="line__value">双方签到 · 一次性履约码</text></view><view class="line"><text>资金结算</text><text class="line__value">双方确认完成后打款</text></view></view>
</view>
<button wx:if="{{order.status === 'service' || order.status === 'in_service'}}" class="emergency-float" bindtap="callEmergencyContact" aria-label="紧急联系预设联系人">紧急联系</button>
<view class="bottom-actions"><button class="btn" bindtap="contact">联系Coser</button><button wx:if="{{order.status === 'unpaid'}}" class="btn btn--cta" bindtap="pay">{{identityPassed ? '立即支付 ¥' + order.amount : '核验下单资格'}}</button><button wx:elif="{{order.status === 'in_service'}}" class="btn btn--cta" bindtap="complete">确认完成</button><button wx:else class="btn btn--primary" disabled>平台担保中</button></view>
