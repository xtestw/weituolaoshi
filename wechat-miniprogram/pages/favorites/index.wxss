.favorites-page { padding-top: 28rpx; }
.favorites-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 22rpx; }
.favorite-card { margin-bottom: 20rpx; padding: 20rpx; border: 1rpx solid var(--color-border); border-radius: 28rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(55,42,77,.05); }
.favorite-card__main { width: 100%; min-height: 164rpx; display: flex; align-items: stretch; gap: 20rpx; margin: 0; padding: 0; border: 0; background: transparent; text-align: left; color: var(--color-text); }
.favorite-card__cover { width: 154rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; background: linear-gradient(145deg,#cbd2ff,#796dec); color: #fff; font-size: 28rpx; font-weight: 800; }
.favorite-card__cover--pink { background: linear-gradient(145deg,#ffb8dd,var(--color-cta)); }
.favorite-card__cover--mint { background: linear-gradient(145deg,#a7e5d5,#4aaf9d); }
.favorite-card__cover--violet { background: linear-gradient(145deg,#d0c2ff,#8264ce); }
.favorite-card__info { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: space-between; }
.favorite-card__title { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; font-size: var(--type-card); font-weight: var(--weight-card); line-height: 1.35; }
.favorite-card__remove { min-height: 72rpx; margin: 14rpx 0 0 auto; padding: 0 16rpx; border: 0; background: transparent; color: var(--color-muted); font-size: 24rpx; }
.empty-state { margin-top: 140rpx; display: flex; flex-direction: column; align-items: center; gap: 12rpx; text-align: center; }
.empty-state__icon { color: #b6a8ec; font-size: 108rpx; line-height: 1; }
.empty-state .btn { margin-top: 28rpx; min-width: 240rpx; }
