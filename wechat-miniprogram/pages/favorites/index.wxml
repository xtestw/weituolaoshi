<view class="page favorites-page">
  <view class="favorites-head"><text class="section__title">我的收藏</text><text class="caption">{{items.length}} 个心仪委托</text></view>
  <view wx:if="{{items.length}}" class="favorite-list">
    <view wx:for="{{items}}" wx:key="id" class="favorite-card">
      <button class="favorite-card__main" data-id="{{item.id}}" bindtap="openService">
        <view class="favorite-card__cover favorite-card__cover--{{item.tone}}"><text>{{item.mark}}</text></view>
        <view class="favorite-card__info"><text class="favorite-card__title">{{item.title}}</text><text class="caption">{{item.coser}} · 上海{{item.district}} · {{item.gender}}</text><text class="price">¥{{item.price}}<text class="price__unit">/小时</text></text></view>
      </button>
      <button class="favorite-card__remove" data-id="{{item.id}}" bindtap="removeFavorite">取消收藏</button>
    </view>
  </view>
  <view wx:else class="empty-state"><view class="empty-state__icon">♡</view><text>还没有收藏的委托</text><text class="caption">看到喜欢的 Coser，可以在详情页收藏</text><button class="btn btn--primary" bindtap="browse">去逛逛</button></view>
</view>
